generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      String   @default("MEMBER")
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reports   Report[]
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  popular   Boolean  @default(false)
  status    String   @default("DRAFT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tools     Tool[]
}

model Company {
  id           String    @id @default(cuid())
  name         String
  website      String
  headquarters String
  foundedYear  Int
  funding      String?
  description  String
  status       String    @default("DRAFT")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  models       AiModel[]
}

model AiModel {
  id            String   @id @default(cuid())
  name          String
  provider      String
  contextWindow String
  pricing       String?
  openSource    Boolean  @default(false)
  documentation String?
  status        String   @default("DRAFT")
  companyId     String?
  company       Company? @relation(fields: [companyId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("ai_models")
}

model Tool {
  id          String   @id @default(cuid())
  name        String
  website     String
  description String
  pricing     String   @default("FREE")
  rating      Float    @default(0)
  bookmarks   Int      @default(0)
  status      String   @default("DRAFT")
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Collection {
  id          String   @id @default(cuid())
  title       String
  curator     String
  description String?
  itemCount   Int      @default(0)
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model News {
  id        String   @id @default(cuid())
  title     String
  category  String
  author    String
  body      String
  status    String   @default("DRAFT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Video {
  id        String   @id @default(cuid())
  title     String
  channel   String
  embedUrl  String
  duration  String
  views     Int      @default(0)
  status    String   @default("DRAFT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Repository {
  id        String   @id @default(cuid())
  name      String
  githubUrl String
  language  String
  license   String
  stars     Int      @default(0)
  status    String   @default("DRAFT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("repositories")
}

model Report {
  id           String   @id @default(cuid())
  target       String
  reason       String
  notes        String?
  status       String   @default("PENDING")
  reportedById String?
  reportedBy   User?    @relation(fields: [reportedById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}