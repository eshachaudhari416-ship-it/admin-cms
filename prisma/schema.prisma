// Admin CMS (Module 12) data model.
// Owns: Tools, Companies, Models, Categories, Collections, News, Videos,
// Repositories, Users, Reports — matching the shared platform schema so
// other modules (Tools listing, Company pages, etc.) read the same tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // swap to "sqlite" for local dev, see .env.example
  url      = env("DATABASE_URL")
  directUrl= env("DIRECT_DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
  MEMBER
}

enum ContentStatus {
  PUBLISHED
  DRAFT
  FLAGGED
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum ReportStatus {
  PENDING
  RESOLVED
  FLAGGED
}

enum Pricing {
  FREE
  FREEMIUM
  PAID
}

model User {
  id        String     @id @default(cuid())
  name      String
  email     String     @unique
  role      Role       @default(MEMBER)
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  reports   Report[]
}

model Category {
  id        String        @id @default(cuid())
  name      String
  slug      String        @unique
  popular   Boolean       @default(false)
  status    ContentStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  tools     Tool[]
}

model Company {
  id           String        @id @default(cuid())
  name         String
  website      String
  headquarters String
  foundedYear  Int
  funding      String?
  description  String
  status       ContentStatus @default(DRAFT)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  models       AiModel[]
}

model AiModel {
  id            String        @id @default(cuid())
  name          String
  provider      String
  contextWindow String
  pricing       String?
  openSource    Boolean       @default(false)
  documentation String?
  status        ContentStatus @default(DRAFT)
  companyId     String?
  company       Company?      @relation(fields: [companyId], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("ai_models")
}

model Tool {
  id          String        @id @default(cuid())
  name        String
  website     String
  imageUrl    String?
  description String
  pricing     Pricing       @default(FREE)
  rating      Float         @default(0)
  bookmarks   Int           @default(0)
  status      ContentStatus @default(DRAFT)
  categoryId  String?
  category    Category?     @relation(fields: [categoryId], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Collection {
  id          String        @id @default(cuid())
  title       String
  curator     String
  imageUrl    String?
  description String?
  itemCount   Int           @default(0)
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model News {
  id        String        @id @default(cuid())
  title     String
  category  String
  author    String
  imageUrl  String?
  body      String
  status    ContentStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Video {
  id        String        @id @default(cuid())
  title     String
  channel   String
  embedUrl  String
  imageUrl  String?
  duration  String
  views     Int           @default(0)
  status    ContentStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Repository {
  id        String        @id @default(cuid())
  name      String
  githubUrl String
  language  String
  license   String
  stars     Int           @default(0)
  status    ContentStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("repositories")
}

model Report {
  id           String       @id @default(cuid())
  target       String
  reason       String
  notes        String?
  status       ReportStatus @default(PENDING)
  reportedById String?
  reportedBy   User?        @relation(fields: [reportedById], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}
